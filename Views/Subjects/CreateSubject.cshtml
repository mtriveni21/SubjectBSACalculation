@model SubjectBSACalculation.Models.Subject
@{
    ViewData["Title"] = "Subject Demograchics Information";
    bool isReadOnly = ViewBag.IsReadOnly ?? false;
}

<h2>Subject Demograchics Information</h2>

@if (isReadOnly)
{
    <div class="alert alert-success">
        Subject Saved successfully as <strong>@Model.SubjectCode</strong>. Please dispense BSA (@Model.BsaFormulaType): <strong>@Model.BsaResult.ToString("F2") m&sup2;</strong>
    </div>
}

<form asp-action="CreateSubject" method="post" class="mt-3" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row mb-3">
        <label asp-for="HeightCm" class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <input asp-for="HeightCm" class="form-control" readonly="@isReadOnly" />
            <span asp-validation-for="HeightCm" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="WeightKg" class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <input asp-for="WeightKg" class="form-control" readonly="@isReadOnly" />
            <span asp-validation-for="WeightKg" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Gender" class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <select asp-for="Gender" class="form-select" disabled="@isReadOnly">
                <option value="">-- Select --</option>
                <option>Male</option>
                <option>Female</option>
                <option>Unknown</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Age" class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <input asp-for="Age" class="form-control" readonly="@isReadOnly" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="BsaFormulaType" class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <select asp-for="BsaFormulaType" class="form-select" disabled="@isReadOnly"
                    asp-items="Html.GetEnumSelectList<SubjectBSACalculation.Models.BsaFormulaType>()"></select>
            <span asp-validation-for="BsaFormulaType" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-8 offset-sm-4">
            @if (isReadOnly)
            {
                <a asp-action="CreateSubject" asp-route-id="@((int?)null)" class="btn btn-secondary">Add New Subject</a>
                <a asp-action="Index" class="btn btn-link">View All Subjects</a>
            }
            else
            {
                <button type="submit" class="btn btn-primary">Save</button>
            }
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
